# Every environment variable the jtf image reads. Names only: values come from Terraform,
# Secret Manager or your shell, never from git.

# Where raw files go: gs://<project>-raw in GCP, file:///some/path for local runs.
JTF_RAW_URL=

# Set by the deploy; recorded in every raw file's sidecar.
JTF_IMAGE_DIGEST=

# healthchecks.io ping URLs, one per capture group. Secrets: Secret Manager in GCP.
# Leave unset locally so a laptop run never marks a real check as healthy.
JTF_HEALTHCHECK_URL_MORNING=
JTF_HEALTHCHECK_URL_JEPX=
JTF_HEALTHCHECK_URL_EVENING=

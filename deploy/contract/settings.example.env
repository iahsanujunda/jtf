# Every environment variable the jtf image reads. Names only: values come from Terraform,
# Secret Manager or your shell, never from git.

# Where raw files go: gs://<project>-raw in GCP, file:///some/path for local runs.
JTF_RAW_URL=

# Which environment these settings are: prod or dev. Prod holds every table that is kept, and is
# written only from a clean checkout of main: Dagster and `jtf parse` refuse anything else. Dev is
# where a change is tried. Unset means dev.
JTF_ENV=

# The project holding the ods dataset, where parsed rows and the file manifest go.
JTF_BIGQUERY_PROJECT=

# Only in dev, and only for dbt: the project whose ods dataset a build reads, when it is not the
# one it writes to. A model tried in dev reads prod's parsed rows. Unset: JTF_BIGQUERY_PROJECT.
JTF_ODS_PROJECT=

# Where BigQuery datasets live, the region in Terraform (asia-northeast1). dbt creates its datasets
# there; without it they would land in the US and could not join ODS.
JTF_BIGQUERY_LOCATION=

# dbt's datasets are named <prefix>_<layer> (dev_dwd, dev_dws): yours in dev, pr_<n> in CI.
JTF_DBT_DATASET_PREFIX=

# Set by the deploy; recorded in every raw file's sidecar and every backtest's MLflow run.
JTF_IMAGE_DIGEST=

# MLflow's own setting, read by backtests. Unset: mlflow.db at the repository root (phase 1).
MLFLOW_TRACKING_URI=

# Where a new MLflow experiment keeps its runs' files: gs://<project>-models/mlflow in prod.
# Unset: mlruns/ at the repository root.
JTF_MLFLOW_ARTIFACTS=

# Where the two UIs are opened, for the links between a run in Dagster and its entries in MLflow.
# Unset: http://localhost:3000 and http://localhost:5000, as `make dagster` and `mlflow ui` serve them.
JTF_DAGSTER_URL=
JTF_MLFLOW_URL=

# healthchecks.io project ping key. Each capture job pings https://hc-ping.com/<key>/jtf-<source>.
# Secret: Secret Manager in GCP. Leave unset locally so a laptop run never marks a real check as healthy.
JTF_HEALTHCHECK_PING_KEY=
